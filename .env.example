# ── Qwen3 LLM ──────────────────────────────────────────────────────────────────
QWEN3_API_URL=http://localhost:11434
QWEN3_API_KEY=
QWEN3_MODEL=ollama pull qwen3:1.7b

# ── BGE-M3 Embedding Service (Python FastAPI) ───────────────────────────────────
EMBEDDING_SERVICE_URL=http://localhost:8001

# ── BGE Reranker Service (Python FastAPI) ───────────────────────────────────────
RERANKER_SERVICE_URL=http://localhost:8002

# ── Qdrant Vector Database ──────────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=amazon_reviews

# ── HuggingFace Dataset ─────────────────────────────────────────────────────────
HF_TOKEN=
HF_DATASET_SUBSET=en
HF_DATASET_SPLIT=train
HF_MAX_RECORDS=10000
